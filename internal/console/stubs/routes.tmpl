package {{ .PackageName }}

import (
	"github.com/gin-gonic/gin"

	"bgin/internal/middleware"
	"bgin/internal/platform/authorization"
)

{{ if .IsAdmin }}
// RegisterAdminRoutes 注册管理端点 ({{ .RoutePath }})。
func RegisterAdminRoutes(router *gin.RouterGroup, handler *Handler, mw *middleware.Middleware) {
	group := router.Group("{{ .RoutePath }}", mw.RateLimit(middleware.TierAuthenticated), mw.RequireAuth())

	group.GET("", mw.RequirePermission(authorization.Resource("{{ .PluralSnake }}"), authorization.ActionList), handler.List)
	group.POST("", mw.RequirePermission(authorization.Resource("{{ .PluralSnake }}"), authorization.ActionCreate), handler.Create)
	group.GET("/:id", mw.RequirePermission(authorization.Resource("{{ .PluralSnake }}"), authorization.ActionRead), handler.GetByID)
	group.PATCH("/:id", mw.RequirePermission(authorization.Resource("{{ .PluralSnake }}"), authorization.ActionUpdate), handler.Update)
	group.DELETE("/:id", mw.RequirePermission(authorization.Resource("{{ .PluralSnake }}"), authorization.ActionDelete), handler.Delete)
}
{{ else }}
// RegisterRoutes 注册业务路由端点 ({{ .RoutePath }})。
func RegisterRoutes(router *gin.RouterGroup, handler *Handler, mw *middleware.Middleware) {
	group := router.Group("{{ .RoutePath }}", mw.RateLimit(middleware.TierAuthenticated), mw.RequireAuth())

	group.GET("", handler.List)
	group.POST("", handler.Create)
	group.GET("/:id", handler.GetByID)
	group.PATCH("/:id", handler.Update)
	group.DELETE("/:id", handler.Delete)
}
{{ end }}
