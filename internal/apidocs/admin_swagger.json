{
    "swagger": "2.0",
    "info": {
        "description": "取值为 \"Bearer \u003caccess_token\u003e\"，含 Bearer 前缀与一个空格（要求具有管理员角色）。",
        "title": "bgin Admin API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/v1",
    "paths": {
        "/admin/auth/change-password": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "校验当前管理员口令后写入新口令。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "管理员认证"
                ],
                "summary": "管理员修改口令",
                "parameters": [
                    {
                        "description": "当前口令与新口令",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/adminauth.ChangePasswordRequest"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "修改成功，无响应体"
                    }
                },
                "x-order": 5
            }
        },
        "/admin/auth/get-session": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "根据当前有效的管理员访问令牌，返回当前管理员的档案资料与权限角色。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "管理员认证"
                ],
                "summary": "获取当前管理员会话",
                "responses": {
                    "200": {
                        "description": "当前管理员会话档案",
                        "schema": {
                            "$ref": "#/definitions/adminauth.GetSessionResponse"
                        }
                    }
                },
                "x-order": 2
            }
        },
        "/admin/auth/sign-in/email": {
            "post": {
                "description": "校验管理员邮箱与口令；邮箱不存在、口令错误或角色非系统管理员统一返回凭据错误，防止账号枚举。登录成功后颁发双令牌。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "管理员认证"
                ],
                "summary": "管理员邮箱密码登录",
                "parameters": [
                    {
                        "description": "管理员登录凭据",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/adminauth.SignInEmailRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "登录成功并颁发管理端双令牌",
                        "schema": {
                            "$ref": "#/definitions/adminauth.SessionResponse"
                        }
                    }
                },
                "x-order": 1
            }
        },
        "/admin/auth/sign-out": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "作废当前管理员访问令牌。若同时传入刷新令牌则一并作废，否则续签通道仍然敞开。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "管理员认证"
                ],
                "summary": "管理员登出",
                "parameters": [
                    {
                        "description": "可选的刷新令牌",
                        "name": "payload",
                        "in": "body",
                        "schema": {
                            "$ref": "#/definitions/adminauth.SignOutRequest"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "已登出，无响应体"
                    }
                },
                "x-order": 4
            }
        },
        "/admin/auth/token/refresh": {
            "post": {
                "description": "使用未过期的管理员刷新令牌轮换一对新的双令牌，旧刷新令牌立即作废。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "管理员认证"
                ],
                "summary": "刷新管理员双令牌",
                "parameters": [
                    {
                        "description": "刷新令牌凭据",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/adminauth.RefreshTokenRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "刷新成功并颁发新双令牌",
                        "schema": {
                            "$ref": "#/definitions/adminauth.SessionResponse"
                        }
                    }
                },
                "x-order": 3
            }
        },
        "/admin/users": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "根据分页、关键字、状态与角色条件查询系统用户列表。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "用户管理"
                ],
                "summary": "用户分页列表",
                "parameters": [
                    {
                        "maximum": 1000000,
                        "minimum": 1,
                        "type": "integer",
                        "example": 1,
                        "description": "当前页码 (从 1 开始，默认 1，上限 1000000，与 maxPage 常量保持一致)",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "maximum": 100,
                        "minimum": 1,
                        "type": "integer",
                        "example": 20,
                        "description": "每页条数 (1-100，默认 20)",
                        "name": "pageSize",
                        "in": "query"
                    },
                    {
                        "enum": [
                            "user",
                            "admin"
                        ],
                        "type": "string",
                        "example": "user",
                        "x-enum-varnames": [
                            "RoleUser",
                            "RoleAdmin"
                        ],
                        "description": "按权限角色过滤 (user: 普通用户, admin: 系统管理员)",
                        "name": "role",
                        "in": "query"
                    },
                    {
                        "maxLength": 120,
                        "type": "string",
                        "example": "alex",
                        "description": "关键字搜索 (按邮箱、昵称、用户名模糊检索)",
                        "name": "search",
                        "in": "query"
                    },
                    {
                        "maxLength": 120,
                        "type": "string",
                        "example": "-createdAt",
                        "description": "排序字段 (字段名前加 - 表示倒序，如 -createdAt)",
                        "name": "sort",
                        "in": "query"
                    },
                    {
                        "enum": [
                            "active",
                            "inactive",
                            "pending",
                            "suspended",
                            "banned",
                            "active",
                            "inactive",
                            "pending",
                            "suspended",
                            "banned"
                        ],
                        "type": "string",
                        "example": "active",
                        "x-enum-varnames": [
                            "StatusActive",
                            "StatusInactive",
                            "StatusPending",
                            "StatusSuspended",
                            "StatusBanned"
                        ],
                        "description": "按账号状态过滤 (active: 正常活跃, inactive: 未激活, banned: 已封禁)",
                        "name": "status",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "用户分页列表",
                        "schema": {
                            "$ref": "#/definitions/admin.UserPage"
                        }
                    }
                },
                "x-order": 1
            },
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "管理员直接创建新用户账号，指定邮箱、口令、昵称与角色等信息。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "用户管理"
                ],
                "summary": "创建系统用户",
                "parameters": [
                    {
                        "description": "创建用户载荷",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/admin.CreateUserRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "新建成功的用户对象",
                        "schema": {
                            "$ref": "#/definitions/admin.User"
                        }
                    }
                },
                "x-order": 3
            }
        },
        "/admin/users/{id}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "根据用户唯一标识查询用户完整档案与管理审计信息。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "用户管理"
                ],
                "summary": "获取用户详情",
                "parameters": [
                    {
                        "type": "string",
                        "example": "\"usr_01J9X4N8Y0ABCD\"",
                        "description": "用户唯一标识",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "用户完整档案",
                        "schema": {
                            "$ref": "#/definitions/admin.User"
                        }
                    }
                },
                "x-order": 2
            },
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "物理删除指定用户及其关联账号数据，并级联清理权限策略。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "用户管理"
                ],
                "summary": "注销删除用户",
                "parameters": [
                    {
                        "type": "string",
                        "example": "\"usr_01J9X4N8Y0ABCD\"",
                        "description": "用户唯一标识",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "删除成功，无响应体"
                    }
                },
                "x-order": 5
            },
            "patch": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "支持局部字段三态更新，可修改昵称、头像、用户名、手机号、角色、状态及封禁属性。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "用户管理"
                ],
                "summary": "更新用户信息",
                "parameters": [
                    {
                        "type": "string",
                        "example": "\"usr_01J9X4N8Y0ABCD\"",
                        "description": "用户唯一标识",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "局部更新载荷",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/admin.UpdateUserRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "更新后的用户对象",
                        "schema": {
                            "$ref": "#/definitions/admin.User"
                        }
                    }
                },
                "x-order": 4
            }
        },
        "/payments/notify/{channel}": {
            "post": {
                "description": "接收微信或支付宝服务端的支付与退款异步通知，由网关执行公钥/证书验签、幂等防重检查与业务状态机推进，返回渠道约定的确认应答。",
                "consumes": [
                    "application/json",
                    "application/x-www-form-urlencoded"
                ],
                "produces": [
                    "application/json",
                    "text/plain"
                ],
                "tags": [
                    "支付中心"
                ],
                "summary": "支付与退款异步通知回调",
                "parameters": [
                    {
                        "enum": [
                            "wechat",
                            "alipay"
                        ],
                        "type": "string",
                        "description": "支付渠道 (wechat, alipay)",
                        "name": "channel",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "应用标识 (可选，缺省时使用渠道默认应用)",
                        "name": "app",
                        "in": "path"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "回调验签与业务消费成功",
                        "schema": {
                            "$ref": "#/definitions/payment.CallbackAckResponse"
                        }
                    }
                },
                "x-order": 1
            }
        },
        "/payments/return/alipay": {
            "get": {
                "description": "用户在支付宝完成付款后由浏览器重定向跳回，经公钥验签通过后 302 跳转至前端订单结果展示页。仅作展示导流，实际支付状态严格以异步通知为准。",
                "consumes": [
                    "text/html"
                ],
                "produces": [
                    "text/html"
                ],
                "tags": [
                    "支付中心"
                ],
                "summary": "支付宝客户端同步重定向跳转",
                "responses": {
                    "302": {
                        "description": "重定向至前端订单展示页",
                        "schema": {
                            "type": "string"
                        }
                    }
                },
                "x-order": 2
            }
        }
    },
    "definitions": {
        "admin.CreateUserRequest": {
            "type": "object",
            "required": [
                "email",
                "name",
                "password",
                "role"
            ],
            "properties": {
                "email": {
                    "description": "用户电子邮箱",
                    "type": "string",
                    "maxLength": 254,
                    "example": "alex@example.com"
                },
                "emailVerified": {
                    "description": "邮箱是否已完成验证",
                    "type": "boolean",
                    "example": true
                },
                "image": {
                    "description": "用户头像 URL",
                    "type": "string",
                    "maxLength": 2048,
                    "example": "https://example.com/avatar.png"
                },
                "name": {
                    "description": "用户展示昵称",
                    "type": "string",
                    "maxLength": 120,
                    "minLength": 1,
                    "example": "Alex Mercer"
                },
                "password": {
                    "description": "登录口令 (8-128位)",
                    "type": "string",
                    "maxLength": 128,
                    "minLength": 8,
                    "example": "Secret123!"
                },
                "role": {
                    "description": "用户权限角色 (user: 普通用户, admin: 系统管理员)",
                    "enum": [
                        "user",
                        "admin"
                    ],
                    "allOf": [
                        {
                            "$ref": "#/definitions/admin.Role"
                        }
                    ],
                    "example": "user"
                },
                "username": {
                    "description": "唯一登录用户名 (3-30位)",
                    "type": "string",
                    "maxLength": 30,
                    "minLength": 3,
                    "example": "alexmercer"
                }
            }
        },
        "admin.Role": {
            "type": "string",
            "enum": [
                "user",
                "admin"
            ],
            "x-enum-varnames": [
                "RoleUser",
                "RoleAdmin"
            ]
        },
        "admin.Status": {
            "type": "string",
