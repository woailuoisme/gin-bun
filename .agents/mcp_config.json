{
  "mcpServers": {
    "ast-grep": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/ast-grep/ast-grep-mcp",
        "ast-grep-server"
      ]
    },
    "codegraph": {
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ]
    },
    "pkg-go-dev": {
      "command": "godig",
      "args": [
        "mcp"
      ]
    },
    "gopls-mcp-server": {
      "command": "go",
      "args": [
        "run",
        "golang.org/x/tools/gopls@latest",
        "mcp"
      ]
    },
    "dbx": {
      "command": "npx",
      "args": [
        "-y",
        "@dbx-app/mcp-server"
      ]
    }
  }
}
