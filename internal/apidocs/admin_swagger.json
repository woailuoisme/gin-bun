        "admin.UserPage": {
            "type": "object",
            "properties": {
                "items": {
                    "description": "用户列表数据",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/admin.User"
                    }
                },
                "meta": {
                    "description": "分页元信息",
                    "allOf": [
                        {
                            "$ref": "#/definitions/response.Meta"
                        }
                    ]
                }
            }
        },
        "adminauth.ChangePasswordRequest": {
            "type": "object",
            "required": [
                "currentPassword",
                "newPassword"
            ],
            "properties": {
                "currentPassword": {
                    "description": "当前登录口令",
                    "type": "string",
                    "example": "Admin123!"
                },
                "newPassword": {
                    "description": "新登录口令 (8-128位，须含字母与数字)",
                    "type": "string",
                    "maxLength": 128,
                    "minLength": 8,
                    "example": "NewAdmin456!"
                }
            }
        },
        "adminauth.GetSessionResponse": {
            "type": "object",
            "properties": {
                "user": {
                    "description": "当前登录管理员身份资料投影",
                    "allOf": [
                        {
                            "$ref": "#/definitions/adminauth.Profile"
                        }
                    ]
                }
            }
