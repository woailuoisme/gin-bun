package {{ .PackageName }}

import (
	"context"
	"database/sql"
	"errors"
	"time"

	"github.com/uptrace/bun"

	"bgin/internal/shared/models"
)

// Repository 定义 {{ .ChineseName }} 模块的数据持久化契约。
type Repository interface {
	Count(ctx context.Context, query List{{ .PascalName }}Query) (int, error)
	List(ctx context.Context, query List{{ .PascalName }}Query, offset, limit int) ([]models.{{ .PascalName }}, error)
	FindByID(ctx context.Context, id string) (*models.{{ .PascalName }}, error)
	Create(ctx context.Context, entity *models.{{ .PascalName }}) error
	Update(ctx context.Context, entity *models.{{ .PascalName }}, columns ...string) error
	Delete(ctx context.Context, id string) error
}

type repository struct {
	db *bun.DB
}

// NewRepository 实例化 {{ .ChineseName }} 数据仓库。
func NewRepository(db *bun.DB) Repository {
	return &repository{db: db}
}

func (r *repository) Count(ctx context.Context, query List{{ .PascalName }}Query) (int, error) {
	q := r.db.NewSelect().Model((*models.{{ .PascalName }})(nil))
	if query.Search != "" {
		q = q.Where("name ILIKE ?", "%"+query.Search+"%")
	}
	if query.Status != "" {
		q = q.Where("status = ?", query.Status)
	}

	return q.Count(ctx)
}

func (r *repository) List(ctx context.Context, query List{{ .PascalName }}Query, offset, limit int) ([]models.{{ .PascalName }}, error) {
	var list []models.{{ .PascalName }}
	q := r.db.NewSelect().Model(&list)

	if query.Search != "" {
		q = q.Where("name ILIKE ?", "%"+query.Search+"%")
	}
	if query.Status != "" {
		q = q.Where("status = ?", query.Status)
	}

	switch query.Sort {
	case "created_at_asc":
		q = q.Order("created_at ASC")
	default:
		q = q.Order("created_at DESC")
	}

	err := q.Offset(offset).Limit(limit).Scan(ctx)
	return list, err
}

func (r *repository) FindByID(ctx context.Context, id string) (*models.{{ .PascalName }}, error) {
	entity := new(models.{{ .PascalName }})
	err := r.db.NewSelect().Model(entity).Where("id = ?", id).Scan(ctx)
	if err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return nil, nil
		}
		return nil, err
	}
	return entity, nil
}

func (r *repository) Create(ctx context.Context, entity *models.{{ .PascalName }}) error {
	_, err := r.db.NewInsert().Model(entity).Exec(ctx)
	return err
}

func (r *repository) Update(ctx context.Context, entity *models.{{ .PascalName }}, columns ...string) error {
	entity.UpdatedAt = time.Now().UTC()
	q := r.db.NewUpdate().Model(entity).WherePK()
	if len(columns) > 0 {
		columns = append(columns, "updated_at")
		q = q.Column(columns...)
	}
	_, err := q.Exec(ctx)
	return err
}

func (r *repository) Delete(ctx context.Context, id string) error {
	_, err := r.db.NewDelete().Model((*models.{{ .PascalName }})(nil)).Where("id = ?", id).Exec(ctx)
	return err
}
