# 复制为 .env 使用，进程环境优先于本文件。

# ── 应用配置 ─────────────────────────────────────────────────────────────
APP_NAME=bgin
# 运行环境: local | development | test | staging | production
APP_ENV=local
APP_DEBUG=true
# 应用时区 (如 UTC, Asia/Shanghai)
APP_TIMEZONE=Asia/Shanghai
# Gin 运行模式: debug | release | test (留空按 APP_ENV 自动推导)
# GIN_MODE=release
# 是否挂载 /docs 接口文档
ENABLE_DOCS=false
APP_PORT=3300
# 前端站点地址 (用于拼接密码重置邮件等链接)
APP_URL=http://localhost:5173

# ── 数据库 (PostgreSQL 18+) ─────────────────────────────────────────────
DB_URL=postgres://postgres:secret@127.0.0.1:5432/bgin?sslmode=disable

# 集成测试专用数据库 (just test-int 读取，勿指向业务库)
TEST_DATABASE_URL=postgres://postgres:secret@127.0.0.1:5432/bgin_test?sslmode=disable

# Atlas 迁移比对库 (值含 & 须加引号，勿指向业务库)
ATLAS_DEV_URL='postgres://postgres:secret@127.0.0.1:5432/atlas_dev?sslmode=disable&search_path=public'

# ── 缓存 / Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://:redis_secret@127.0.0.1:6379/0

# ── 对象存储 ────────────────────────────────────────────────────────────
# 存储磁盘: local | s3
FILESYSTEM_DISK=local
STORAGE_LOCAL_ROOT=./storage/app/uploads
# STORAGE_LOCAL_URL=http://localhost:3300/uploads

# S3 / MinIO / Garage / R2 (FILESYSTEM_DISK=s3 时启用)
# AWS_ENDPOINT=127.0.0.1:3900
# AWS_BUCKET=bgin
# AWS_DEFAULT_REGION=garage
# AWS_ACCESS_KEY_ID=GKxxxxxxxxxxxxxxxxxxxxxxxx
# AWS_SECRET_ACCESS_KEY=replace-with-your-own-key-secret
# AWS_USE_SSL=false
# AWS_URL=

# ── JWT ─────────────────────────────────────────────────────────────────
# 签名密钥 (至少 32 字符，运行 bgin jwt:secret 或 just jwt-secret 生成并写入 .env)
JWT_SECRET=
JWT_ISSUER=bgin
JWT_TTL=15m
JWT_REFRESH_TTL=720h

# ── 邮件服务 (Mailpit / Resend) ──────────────────────────────────────────
MAIL_DRIVER=mailpit
MAIL_FROM_ADDRESS=no-reply@bgin.local
MAIL_FROM_NAME=bgin
MAILPIT_HOST=127.0.0.1
MAILPIT_PORT=1025
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_BASE_URL=https://api.resend.com

# ── 国际化 ──────────────────────────────────────────────────────────────
APP_LOCALE=en

# ── 日志 ────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
# 日志通道: console (本地开发控制台) | json (生产环境采集)
LOG_CHANNEL=console

# ── 认证策略 ────────────────────────────────────────────────────────────
# 是否强制验证邮箱后方可登录
REQUIRE_EMAIL_VERIFICATION=false
OTP_TTL=10m
OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_TTL=30m

# ── 接口限流 (每分钟请求数) ─────────────────────────────────────────────
RATELIMIT_ANONYMOUS=60
RATELIMIT_AUTHENTICATED=300
RATELIMIT_SENSITIVE=10

# ── 跨域设置 ────────────────────────────────────────────────────────────
# 逗号分隔的允许来源，* 仅限本地开发
CORS_ALLOWED_ORIGINS=*

# ── 初始管理员播种 (仅 db:seed 使用) ────────────────────────────────────
SEED_ADMIN_EMAIL=admin@bgin.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator

# ── 实时通信 (Centrifugo) ────────────────────────────────────────────────
CENTRIFUGO_ENABLED=false
CENTRIFUGO_URL=http://127.0.0.1:48000/api
CENTRIFUGO_API_KEY=aef5a17a-fdeb-48aa-b2c1-d490c62ff950
CENTRIFUGO_SECRET=768583f3-7205-4b36-aea3-32ca8dea4914
# 签发给客户端的连接凭据有效期（连接凭据应短于会话寿命，过期后客户端重新申请）
CENTRIFUGO_TOKEN_TTL=2h

# ── 微信开放平台 (小程序能力) ──────────────────────────────────────────
WECHAT_MINIPROGRAM_APP_ID=
WECHAT_MINIPROGRAM_APP_SECRET=

# ── 支付渠道 (微信支付 & 支付宝) ─────────────────────────────────────────
PAYMENT_FAKE_ENABLED=false
# 支付证书根目录（证书若配置相对路径，将以该目录为基准解析）
PAYMENT_CERTS_DIR=./storage/app/certs
# 微信支付单应用配置（多应用使用 WECHAT_PAY_APPS_JSON）
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MCH_SERIAL_NO=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_MERCHANT_PRIVATE_KEY_PATH=./storage/app/certs/wechat/apiclient_key.pem
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=./storage/app/certs/wechat/pub_key.pem
WECHAT_PAY_PLATFORM_PUBLIC_KEY_ID=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_SCENES=
# 支付宝单应用配置（多应用使用 ALIPAY_APPS_JSON）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY_PATH=./storage/app/certs/alipay/app_private_key.pem
ALIPAY_APP_CERT_PATH=./storage/app/certs/alipay/appCertPublicKey.crt
ALIPAY_PUBLIC_CERT_PATH=./storage/app/certs/alipay/alipayCertPublicKey_RSA2.crt
ALIPAY_ROOT_CERT_PATH=./storage/app/certs/alipay/alipayRootCert.crt
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=
ALIPAY_SCENES=

# ── IP 归属地库 (ip2region) ──────────────────────────────────────────────
GEOIP_ENABLED=false
GEOIP_DB_PATH=./storage/app/geoip/ip2region_v4.xdb

# ── 多渠道通知系统 (Notification) ──────────────────────────────────────────
NOTIFICATION_WORKER_POOL=10
NOTIFICATION_QUEUE_SIZE=100
NOTIFICATION_SMS_DRIVER=log
NOTIFICATION_SMS_SIGN_NAME=
NOTIFICATION_SMS_ALIYUN_ACCESS_KEY_ID=
NOTIFICATION_SMS_ALIYUN_ACCESS_KEY_SECRET=
NOTIFICATION_SMS_ALIYUN_SIGN_NAME=
NOTIFICATION_SMS_ALIYUN_TEMPLATE_CODE=
NOTIFICATION_SMS_TENCENT_SECRET_ID=
NOTIFICATION_SMS_TENCENT_SECRET_KEY=
NOTIFICATION_SMS_TENCENT_APP_ID=
NOTIFICATION_SMS_TENCENT_SIGN_NAME=
NOTIFICATION_SMS_TENCENT_TEMPLATE_ID=
NOTIFICATION_SMS_TENCENT_REGION=ap-guangzhou
NOTIFICATION_SMS_SMSBAO_USERNAME=
NOTIFICATION_SMS_SMSBAO_API_KEY=
NOTIFICATION_TELEGRAM_BOT_TOKEN=
NOTIFICATION_TELEGRAM_CHAT_ID=
NOTIFICATION_TELEGRAM_API_URL=https://api.telegram.org

# ── PDF 生成引擎 (Maroto v2) ────────────────────────────────────────────────
PDF_FONT_PATH=./storage/fonts/SourceHanSans.ttf
PDF_FONT_FAMILY=SourceHanSans
PDF_PAGE_SIZE=A4
PDF_MARGIN=10
