# ── 应用基础 ─────────────────────────────────────────────────────────────
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Shanghai
APP_URL=http://localhost:5173
ENABLE_DOCS=true
CORS_ALLOWED_ORIGINS=*

# ── 数据库 (PostgreSQL 18+) ─────────────────────────────────────────────
DB_URL=postgres://postgres:secret@127.0.0.1:5432/bgin?sslmode=disable
TEST_DATABASE_URL=postgres://postgres:secret@127.0.0.1:5432/bgin_test?sslmode=disable
ATLAS_DEV_URL='postgres://postgres:secret@127.0.0.1:5432/atlas_dev?sslmode=disable&search_path=public'

# ── 缓存 / Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://:redis_secret@127.0.0.1:6379/0

# ── 对象存储 (Garage S3 / MinIO) ─────────────────────────────────────────
FILESYSTEM_DISK=s3
AWS_ENDPOINT=127.0.0.1:3900
AWS_BUCKET=bgin
AWS_DEFAULT_REGION=garage
AWS_ACCESS_KEY_ID=GKbe9c180b201d91a92ac22fb1
AWS_SECRET_ACCESS_KEY=e8355af22a6346fea59cd81c52c90f7158a85ad0437f1ed1a62380d10478488b
AWS_USE_SSL=false

# ── 图像动态处理 (Imgproxy) ──────────────────────────────────────────────
IMGPROXY_ENABLED=true
IMGPROXY_URL=http://127.0.0.1:8088
IMGPROXY_KEY=016bb66d0d40f8f746c0c327eca2232495bb367e90f5d0124329a0fea07c929b
IMGPROXY_SALT=07c466cebbed802f7b449c67dfad29f393df60f09ffbd2af47462f88791e3ab5

# ── 全文检索 (Scout / Meilisearch) ──────────────────────────────────────
SCOUT_DRIVER=meilisearch
SCOUT_PREFIX=bgin_
MEILISEARCH_KEY=bWaV7Z_2LHrn-t1LIJc3ENDT7R-svZ5tNMsuTifQfX0

# ── 认证与鉴权 ──────────────────────────────────────────────────────────
# JWT 签名密钥 (至少 32 字符，可运行 just jwt-secret 生成)
JWT_SECRET=
SEED_ADMIN_PASSWORD=admin12345

# ── 实时通信 (Centrifugo) ────────────────────────────────────────────────
CENTRIFUGO_ENABLED=true
CENTRIFUGO_URL=http://127.0.0.1:48000/api
CENTRIFUGO_API_KEY=aef5a17a-fdeb-48aa-b2c1-d490c62ff950
CENTRIFUGO_SECRET=768583f3-7205-4b36-aea3-32ca8dea4914

# ── 异常监控与追踪 (GlitchTip / Sentry) ──────────────────────────────────
# 填入 GlitchTip / Sentry DSN 即自动启用，留空则完全禁用
SENTRY_DSN=
# 性能追踪事务采样率 (0.0 到 1.0，0.01 表示 1%)
SENTRY_TRACES_SAMPLE_RATE=0.01
