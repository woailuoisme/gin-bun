                "active",
                "inactive",
                "pending",
                "suspended",
                "banned",
                "active",
                "inactive",
                "pending",
                "suspended",
                "banned"
            ],
            "x-enum-varnames": [
                "StatusActive",
                "StatusInactive",
                "StatusPending",
                "StatusSuspended",
                "StatusBanned"
