# 复制为 .env 使用，进程环境优先于本文件。

# ── 应用配置 ─────────────────────────────────────────────────────────────
APP_NAME=bgin
# 运行环境: local | development | test | staging | production
APP_ENV=local
# Gin 运行模式: debug | release | test (留空按 APP_ENV 自动推导)
# GIN_MODE=release
# 是否挂载 /docs 接口文档
ENABLE_DOCS=false
APP_PORT=3300
# 前端站点地址 (用于拼接密码重置邮件等链接)
APP_URL=http://localhost:5173

# ── 数据库 (PostgreSQL 18+) ─────────────────────────────────────────────
DB_URL=postgres://postgres:secret@127.0.0.1:5432/bgin?sslmode=disable
# 连接池设置 (不可为 0)
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
DB_CONNECT_TIMEOUT=5s
# 查询超时与事务空闲超时 (0 表示沿用服务端设置)
DB_STATEMENT_TIMEOUT=30s
DB_IDLE_IN_TX_TIMEOUT=60s

# 集成测试专用数据库 (just test-int 读取，勿指向业务库)
TEST_DATABASE_URL=postgres://postgres:secret@127.0.0.1:5432/bgin_test?sslmode=disable

# Atlas 迁移比对库 (值含 & 须加引号，勿指向业务库)
ATLAS_DEV_URL='postgres://postgres:secret@127.0.0.1:5432/atlas_dev?sslmode=disable&search_path=public'

# ── 缓存 / Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://:redis_secret@127.0.0.1:6379/0

# ── 对象存储 ────────────────────────────────────────────────────────────
# 存储驱动: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage/app/uploads
# STORAGE_LOCAL_URL=http://localhost:3300/uploads

# S3 / MinIO / Garage / R2 (STORAGE_DRIVER=s3 时启用)
# S3_ENDPOINT=127.0.0.1:3900
# S3_BUCKET=bgin
# S3_REGION=garage
# S3_ACCESS_KEY_ID=GKxxxxxxxxxxxxxxxxxxxxxxxx
# S3_SECRET_ACCESS_KEY=replace-with-your-own-key-secret
# S3_USE_SSL=false
# S3_PUBLIC_URL=

# ── JWT ─────────────────────────────────────────────────────────────────
# 签名密钥 (至少 32 字符，生产环境严禁使用默认值)
JWT_SECRET=dev-only-insecure-secret-change-me-please-32b
JWT_ISSUER=bgin
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# ── 邮件服务 (Mailpit / SMTP) ───────────────────────────────────────────
MAIL_URL=smtp://127.0.0.1:1025
MAIL_FROM_ADDRESS=no-reply@bgin.local
MAIL_FROM_NAME=bgin

# ── 国际化 ──────────────────────────────────────────────────────────────
I18N_DEFAULT_LANGUAGE=en

# ── 日志 ────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
# 日志格式: console (本地开发) | json (生产环境采集)
LOG_OUTPUT=console

# ── 认证策略 ────────────────────────────────────────────────────────────
# 是否强制验证邮箱后方可登录
REQUIRE_EMAIL_VERIFICATION=false
OTP_TTL=10m
OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_TTL=30m

# ── 接口限流 (每分钟请求数) ─────────────────────────────────────────────
RATELIMIT_ANONYMOUS=60
RATELIMIT_AUTHENTICATED=300
RATELIMIT_SENSITIVE=10

# ── 跨域设置 ────────────────────────────────────────────────────────────
# 逗号分隔的允许来源，* 仅限本地开发
CORS_ALLOWED_ORIGINS=*

# ── 初始管理员播种 (仅 db:seed 使用) ────────────────────────────────────
SEED_ADMIN_EMAIL=admin@bgin.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator
